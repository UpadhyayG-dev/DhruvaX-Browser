{
  "name": "sparsh-browser",
  "version": "1.0.0",
  "description": "Spàrsh - A free, open-source web browser inspired by Comet Browser",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:android": "node scripts/build-android.js",
    "build:all": "node scripts/build-all.js",
    "build:windows": "node scripts/build-windows.js",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "clean": "rimraf dist android/app/build",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "browser",
    "web",
    "electron",
    "open-source",
    "sparsh"
  ],
  "author": "Spàrsh Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.4",
    "sqlite3": "^5.1.6"
  },
  "build": {
    "appId": "com.sparsh.browser",
    "productName": "Spàrsh Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}