{
  "name": "sparsh-browser",
  "version": "1.0.0",
  "description": "Spàrsh - A free, open-source web browser with modern UI and privacy features",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:android": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "dev": "electron . --dev"
  },
  "build": {
    "appId": "com.sparsh.browser",
    "productName": "Spàrsh Browser",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "browser",
    "web browser",
    "privacy",
    "open source",
    "sparsh"
  ],
  "author": "Spàrsh Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
